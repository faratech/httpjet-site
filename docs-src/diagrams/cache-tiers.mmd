  end
  IDX -- "lookup" --> HOT
  HOT -- "cold" --> F
  F -- "~µs read + decode" --> HOT
  IDX -- "teardown (evict · expire · purge · replace)<br/>synchronous under the shard lock: index + file + hot + tags" --> F
