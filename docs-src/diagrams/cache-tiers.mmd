flowchart LR
  classDef ram fill:#13203a,stroke:#818cf8,color:#fff
  classDef disk fill:#0e1424,stroke:#22d3ee,color:#e8ecf6
  subgraph RAM ["process RAM"]
    IDX["sharded index<br/>metadata · tags · variants · TTL heap<br/>--page-cache-mem (128 MiB)"]:::ram
    HOT["hot tier<br/>hottest bodies, zero-syscall serve<br/>--page-cache-hot-mem (192 MiB)"]:::ram
  end
  subgraph TMPFS ["--page-cache-store-path (tmpfs, e.g. /dev/shm/jetcache)"]
