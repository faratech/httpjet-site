flowchart TB
  U["Incoming QUIC Initial"] --> A{"Accepting, global capacity available<br/>and fewer than 256 pending on this core?"}
  A -- no --> F["Refuse"]
  A -- yes --> R{"Unvalidated address and<br/>at least 64 pending?"}
  R -- yes --> RR["Retry if possible, otherwise refuse"]
  R -- no --> H["Take handshake slot<br/>10-second deadline"]
  H --> C{"Connected and active permit available?"}
  C -- no --> X["Close or time out"]
  C -- yes --> Q["Serve HTTP/3 requests"]
  Q -- "legacy (default)" --> B["Bridge to shared pipeline"]
  Q -- "accelerated / auto" --> P{"Eligible on-core response?"}
  P -- no --> B
  P -- yes --> E["Write response"]
  B --> E
