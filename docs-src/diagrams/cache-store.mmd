flowchart TB
  A["Backend or static response"] --> B{"GET and cacheable response<br/>passing shared guards?"}
  B -- no --> N["Do not store"]
  B -- yes --> C{"Cache disposition<br/>and request route"}
  C -- "public + public route" --> P{"Public policy, vary<br/>and cookie guards pass?"}
  C -- "private + private route" --> Q{"Private vary<br/>and policy guards pass?"}
  C -- "other combinations" --> N
  P -- no --> N
  Q -- no --> N
  P -- yes --> D{"Admission threshold met?"}
  D -- no --> N
  D -- yes --> STORE["Store public entry"]
  Q -- yes --> PRIV["Store private entry<br/>without frequency admission"]
  STORE --> F{"File tier enabled?"}
  PRIV --> F
  F -- no --> RAM["Keep body in RAM"]
  F -- yes --> FILE["Write file; optionally recompress<br/>in bounded background work"]
  click D "page-cache.html#admission"
