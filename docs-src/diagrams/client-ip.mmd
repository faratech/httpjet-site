flowchart TB
  A["Socket peer or validated PROXY source"] --> B["Resolve vhost and classify peer"]
  B --> C["Apply plaintext HTTPS policy for mTLS vhost"]
  C -- "request continues" --> D{"Mode 2: trusted peer and TLS eligibility?"}
  D -- yes --> F["Prefer CF-Connecting-IP,<br/>then rightmost untrusted X-Forwarded-For"]
  D -- no --> G["Use the peer address"]
  F & G --> H["Evaluate peer and client ACLs"]
  H --> I["Apply request throttle and GeoIP / ASN rules"]
  I --> J["Use resolved client IP for application and logs"]
